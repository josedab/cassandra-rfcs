# Cassandra Schema Designer Tool Launcher

if [ "x$CASSANDRA_HOME" = "x" ]; then
    CASSANDRA_HOME="$(cd "$(dirname "$0")/../../.." && pwd)"
fi

# Add Cassandra libraries to classpath
CLASSPATH="$CASSANDRA_HOME/build/classes/main"
CLASSPATH="$CLASSPATH:$CASSANDRA_HOME/build/classes/thrift"
CLASSPATH="$CLASSPATH:$CASSANDRA_HOME/lib/*"

# Java options
JVM_OPTS="${JVM_OPTS} -Xmx256M"
JVM_OPTS="${JVM_OPTS} -Dlogback.configurationFile=logback-tools.xml"

# Launch the tool
exec java $JVM_OPTS -cp "$CLASSPATH" org.apache.cassandra.tools.schemadesigner.SchemaDesignerTool "$@"
